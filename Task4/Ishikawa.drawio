        <mxCell id="hbCVAF_-dlO54tdE_vUi-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=right;fontSize=8;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Технический долг&lt;/h1&gt;&lt;p&gt;Чтобы избежать - анализируем процессы, мигрируем по плану, проводим контролируемую миграцию&lt;/p&gt;" vertex="1">
